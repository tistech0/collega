# ── Environnement (obligatoire : production sur le NAS) ─────
ENVIRONMENT=production

# ── Base de données ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:TON_MOT_DE_PASSE_DB@db:5432/collega
POSTGRES_PASSWORD=TON_MOT_DE_PASSE_DB

# ── Redis ────────────────────────────────────────────────────
# Mot de passe de Redis (openssl rand -hex 32) : le compose en déduit REDIS_URL
# (redis://:${REDIS_PASSWORD}@redis:6379/0) pour migrate, api et worker.
REDIS_PASSWORD=GENERE_UNE_VALEUR_ALEATOIRE

# ── Image déployée (écrit par scripts/deploy.sh, ne pas éditer à la main) ──
IMAGE_TAG=

# ── JWT ──────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
SECRET_KEY=GENERE_UNE_VALEUR_ALEATOIRE

# ── Anthropic / Claude ───────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ── RevenueCat ───────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=TON_SECRET_REVENUECAT

# ── Interface admin (HTTP Basic Auth) ────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_CE_MOT_DE_PASSE
