# development | production
# En prod (`ENVIRONMENT=production`), les validators Pydantic refusent les
# valeurs par défaut faibles sur les variables suivantes — backend refuse de
# démarrer si l'une d'elles est laissée à un placeholder `change-me*` :
#   - SECRET_KEY (≥ 32 chars, non placeholder)
#   - CLAUDE_API_KEY (commence par `sk-ant-`, ≥ 20 chars)
#   - ADMIN_PASSWORD (non placeholder)
#   - REVENUECAT_WEBHOOK_SECRET (non vide ET non placeholder)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/collega
POSTGRES_PASSWORD=password
REDIS_URL=redis://redis:6379/0
# Proxys de confiance (CIDR séparés par des virgules) dont on lit CF-Connecting-IP / X-Forwarded-For.
# Défaut : réseau Docker de Nginx Proxy Manager.
# TRUSTED_PROXY_IPS=172.16.0.0/12
SECRET_KEY=change-me-in-production-use-at-least-32-chars
CLAUDE_API_KEY=sk-ant-api03-...
RELOAD_COUNT_MAX=2
MONTHLY_RELOADS_MAX=3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
REVENUECAT_WEBHOOK_SECRET=change-me-in-production
